SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
DIRECT_URL=
OPENAI_API_KEY=
PORT=3001
# Set to "true" ONLY in local development to bypass JWT auth with a hardcoded
# dev user. Leave empty/unset everywhere else — auth fails closed by default.
ALLOW_DEV_AUTH=

# Optional AI model overrides (defaults live in src/services/aiModels.ts).
# To roll back to the old stack: VOXLY_CHAT_MODEL=gpt-4o VOXLY_FAST_MODEL=gpt-4o
# VOXLY_STT_MODEL=whisper-1 VOXLY_TTS_MODEL=tts-1 VOXLY_TTS_VOICE=nova
VOXLY_CHAT_MODEL=
VOXLY_FAST_MODEL=
VOXLY_STT_MODEL=
VOXLY_TTS_MODEL=
VOXLY_TTS_VOICE=
# none | low | medium | high — "none" keeps voice replies fastest.
VOXLY_REASONING_EFFORT=
